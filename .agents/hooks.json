{
  "interaction-logger": {
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/log_interactions.py",
        "timeout": 20
      }
    ]
  },
  "api-rest-guardrails": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/api_guardrails_hook.py --event PreInvocation",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/api_guardrails_hook.py --event PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/api_guardrails_hook.py --event Stop",
        "timeout": 25
      }
    ]
  },
  "stryker-post-commit-gate": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/stryker_post_commit_hook.py --event PreInvocation",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/stryker_post_commit_hook.py --event PostToolUse",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
