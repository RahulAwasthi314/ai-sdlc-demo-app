{
  "info": {
    "name": "Backend Invoice Approval Limits API",
    "description": "Postman collection for verifying role limits and approval workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login as Director",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo.director\",\n  \"password\": \"ChangeMe123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Invoices - Create $250k Invoice",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Enterprise Dynamics\",\n  \"amount\": 250000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/invoices",
          "host": ["{{baseUrl}}"],
          "path": ["api", "invoices"]
        }
      }
    },
    {
      "name": "Approvals - Approve Within Director Limit ($250k)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/approvals/INV-101/approve",
          "host": ["{{baseUrl}}"],
          "path": ["api", "approvals", "INV-101", "approve"]
        }
      }
    },
    {
      "name": "Approvals - Blocked Over Limit ($550k)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/approvals/INV-999/approve",
          "host": ["{{baseUrl}}"],
          "path": ["api", "approvals", "INV-999", "approve"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ]
}

